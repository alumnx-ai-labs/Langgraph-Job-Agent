# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=<<your_anthropic_api_key_here>>

# Optional: which Claude model to use (default: claude-sonnet-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Required for the duplicate-check/publish steps: MongoDB Atlas connection string.
# See README.md "Setup" for how to create a free cluster and get this.
MONGO_URI=<<your_mongodb_atlas_connection_string_here>>

# Optional: set LANGSMITH_TRACING=true and fill these in if you want tracing
# (note: jd_intake_pipeline.py currently forces tracing off, see README Troubleshooting)
LANGSMITH_API_KEY=<<your_langsmith_api_key_here>>
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=<<your_project_name_here>>
